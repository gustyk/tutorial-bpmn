---
/**
 * PeriksaModelApp — case picker + BpmnViewer referensi + CriteriaChecker berdampingan.
 * Daftar kasus ditambah lewat KASUS_TERSEDIA saat WP-7+.
 * Tanpa backend; seluruh pemrosesan di browser.
 */

/**
 * Tambah entri di sini saat WP-7+ membuat criteria.json:
 * { id: 'case-01', label: 'Kasus 1 — Pesanan toko daring', bpmnSrc: '/bpmn/case-01-order.bpmn', criteriaSrc: '/criteria/case-01/criteria.json' }
 */
const KASUS_TERSEDIA: Array<{ id: string; label: string; bpmnSrc: string; criteriaSrc: string }> = [
  {
    id: 'case-01',
    label: 'Kasus 1 — Pesanan diterima sampai dikirim',
    bpmnSrc: '/bpmn/case-01-order.bpmn',
    criteriaSrc: '/cases/case-01/criteria.json',
  },
  {
    id: 'case-02',
    label: 'Kasus 2 — Order perlu divalidasi',
    bpmnSrc: '/bpmn/case-02-order.bpmn',
    criteriaSrc: '/cases/case-02/criteria.json',
  },
  {
    id: 'case-03',
    label: 'Kasus 3 — Customer adalah pihak luar',
    bpmnSrc: '/bpmn/case-03-order.bpmn',
    criteriaSrc: '/cases/case-03/criteria.json',
  },
  {
    id: 'case-04',
    label: 'Kasus 4 — Proses audit pesanan',
    bpmnSrc: '/bpmn/case-04-order.bpmn',
    criteriaSrc: '/cases/case-04/criteria.json',
  },
  {
    id: 'case-05',
    label: 'Kasus 5 — Pembayaran punya batas waktu',
    bpmnSrc: '/bpmn/case-05-order.bpmn',
    criteriaSrc: '/cases/case-05/criteria.json',
  },
  {
    id: 'case-06',
    label: 'Kasus 6 — Dua pekerjaan jalan bersamaan',
    bpmnSrc: '/bpmn/case-06-order.bpmn',
    criteriaSrc: '/cases/case-06/criteria.json',
  },
  {
    id: 'case-07',
    label: 'Kasus 7 — Model mulai terlalu padat',
    bpmnSrc: '/bpmn/case-07-order.bpmn',
    criteriaSrc: '/cases/case-07/criteria.json',
  },
  {
    id: 'case-08',
    label: 'Kasus 8 — Pengiriman bisa gagal',
    bpmnSrc: '/bpmn/case-08-order.bpmn',
    criteriaSrc: '/cases/case-08/criteria.json',
  },
  {
    id: 'case-09',
    label: 'Kasus 9 — Pembatalan setelah pembayaran ditarik',
    bpmnSrc: '/bpmn/case-09-order.bpmn',
    criteriaSrc: '/cases/case-09/criteria.json',
  },
];
---

<div class="pma" data-periksa-app>
  {KASUS_TERSEDIA.length === 0 ? (
    <div class="pma__empty">
      <p>
        Kasus latihan belum tersedia — akan ditambahkan saat modul diterbitkan (WP-7+).
        Pantau halaman ini saat modul baru muncul di sidebar.
      </p>
    </div>
  ) : (
    <>
      <div class="pma__picker">
        <label for="pma-case-select" class="pma__label">Pilih kasus:</label>
        <select id="pma-case-select" class="pma__select" data-case-select>
          <option value="">— pilih kasus —</option>
          {KASUS_TERSEDIA.map((k) => (
            <option value={k.id} data-bpmn-src={k.bpmnSrc} data-criteria-src={k.criteriaSrc}>
              {k.label}
            </option>
          ))}
        </select>
      </div>

      <div class="pma__layout" data-layout hidden>
        <div class="pma__viewer-col">
          <h4 class="pma__col-title">Model referensi</h4>
          <div class="pma__viewer-wrap" data-viewer-wrap>
            {/* BpmnViewer diinjeksi oleh JS saat kasus dipilih */}
          </div>
        </div>
        <div class="pma__checker-col">
          <h4 class="pma__col-title">Periksa model Anda</h4>
          <div class="pma__checker-wrap" data-checker-wrap>
            {/* CriteriaChecker diinjeksi oleh JS saat kasus dipilih */}
          </div>
        </div>
      </div>
    </>
  )}
</div>

<script>
// Wiring dinamis: saat kasus dipilih, tampilkan viewer + checker.
// Saat ini hanya berjalan jika KASUS_TERSEDIA tidak kosong (tidak ada elemen data-case-select).
document.querySelectorAll<HTMLElement>('[data-periksa-app]').forEach((root) => {
  const select = root.querySelector<HTMLSelectElement>('[data-case-select]');
  if (!select) return;

  const layout = root.querySelector<HTMLElement>('[data-layout]')!;
  const viewerWrap = root.querySelector<HTMLElement>('[data-viewer-wrap]')!;
  const checkerWrap = root.querySelector<HTMLElement>('[data-checker-wrap]')!;

  select.addEventListener('change', () => {
    const opt = select.selectedOptions[0];
    const bpmnSrc = opt?.dataset.bpmnSrc ?? '';
    const criteriaSrc = opt?.dataset.criteriaSrc ?? '';

    if (!bpmnSrc || !criteriaSrc) {
      layout.hidden = true;
      return;
    }

    // Buat BpmnViewer untuk referensi
    viewerWrap.innerHTML = `<div class="bpmn-viewer-host" data-bpmn-viewer
      data-src="${bpmnSrc}"
      data-title="Model referensi"
      data-height="clamp(20rem, 50vh, 36rem)"
      ></div>`;

    // Buat CriteriaChecker untuk kasus ini
    checkerWrap.innerHTML = `<div class="cc-host" data-criteria-checker
      data-criteria-src="${criteriaSrc}"
      aria-label="Periksa model Anda"
      ></div>`;

    layout.hidden = false;

    // Re-init komponen (mereka sudah terdaftar via querySelectorAll di masing-masing script)
    // Untuk BpmnViewer: re-dispatch custom init
    viewerWrap.querySelectorAll('[data-bpmn-viewer]').forEach((el) => {
      el.dispatchEvent(new CustomEvent('bpmn-init', { bubbles: true }));
    });
  });
});
</script>

<style>
.pma__empty {
  padding: 1rem;
  background: var(--sl-color-gray-6);
  border: 1px dashed var(--sl-color-gray-4);
  border-radius: 6px;
  color: var(--sl-color-gray-3);
  font-size: .9rem;
}
.pma__picker { display: flex; align-items: center; gap: .6rem; margin-bottom: 1rem; flex-wrap: wrap; }
.pma__label { font-weight: 600; font-size: .9rem; }
.pma__select {
  padding: .35rem .6rem;
  border: 1px solid var(--sl-color-gray-4);
  border-radius: 4px;
  background: var(--sl-color-bg);
  font-size: .875rem;
  min-width: 16rem;
}
.pma__layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.2rem;
}
@media (max-width: 720px) {
  .pma__layout { grid-template-columns: 1fr; }
}
.pma__col-title { margin: 0 0 .5rem; font-size: .9rem; font-weight: 600; }
.pma__viewer-wrap, .pma__checker-wrap { min-height: 10rem; }
</style>
