---
interface Props {
  label?: string;
  storageKey?: string;
}
const { label = 'Lihat jawaban', storageKey } = Astro.props;
---

<details class="reveal" data-reveal data-storage-key={storageKey ?? null}>
  <summary class="reveal__summary">{label}</summary>
  <div class="reveal__body">
    <slot />
  </div>
</details>

<script>
document.querySelectorAll<HTMLDetailsElement>('[data-reveal]').forEach((el) => {
  const key = el.dataset.storageKey;
  if (key && localStorage.getItem(`reveal:${key}`) === '1') el.open = true;
  el.addEventListener('toggle', () => {
    if (key) localStorage.setItem(`reveal:${key}`, el.open ? '1' : '0');
  });
});
</script>

<style>
.reveal {
  border: 1px solid var(--sl-color-gray-5);
  border-radius: 4px;
  margin: 1rem 0;
}
.reveal__summary {
  padding: .6rem .8rem;
  cursor: pointer;
  font-weight: 600;
  list-style: none;
  display: flex;
  align-items: center;
  gap: .5rem;
}
.reveal__summary::before {
  content: '▸';
  font-size: .75rem;
  transition: transform .15s;
}
.reveal[open] .reveal__summary::before { transform: rotate(90deg); }
.reveal__body {
  padding: .5rem .8rem .7rem;
  border-top: 1px solid var(--sl-color-gray-6);
}
.reveal__body :global(p:last-child) { margin-bottom: 0; }
</style>
