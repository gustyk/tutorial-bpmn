<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Def_fondasi_variant_a"
  targetNamespace="https://uisi.ac.id/bpmn-tutorial">
  <bpmn:process id="Proc_fondasi_variant_a" isExecutable="false">
    <bpmn:startEvent id="SE_fondasi_variant_a" name="Alur dimulai">
      <bpmn:outgoing>SF_fondasi_variant_a_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="TA_fondasi_variant_a_1" name="Proses token">
      <bpmn:incoming>SF_fondasi_variant_a_1</bpmn:incoming>
      <bpmn:outgoing>SF_fondasi_variant_a_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EE_fondasi_variant_a" name="Token selesai">
      <bpmn:incoming>SF_fondasi_variant_a_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_fondasi_variant_a_1" sourceRef="SE_fondasi_variant_a" targetRef="TA_fondasi_variant_a_1"/>
    <bpmn:sequenceFlow id="SF_fondasi_variant_a_2" sourceRef="TA_fondasi_variant_a_1" targetRef="EE_fondasi_variant_a"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_fondasi_variant_a">
    <bpmndi:BPMNPlane id="Plane_fondasi_variant_a" bpmnElement="Proc_fondasi_variant_a">
      <bpmndi:BPMNShape id="Shp_SE_fondasi_variant_a" bpmnElement="SE_fondasi_variant_a">
        <dc:Bounds x="152" y="82" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shp_TA_fondasi_variant_a_1" bpmnElement="TA_fondasi_variant_a_1">
        <dc:Bounds x="240" y="60" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shp_EE_fondasi_variant_a" bpmnElement="EE_fondasi_variant_a">
        <dc:Bounds x="412" y="82" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_SF_fondasi_variant_a_1" bpmnElement="SF_fondasi_variant_a_1">
        <di:waypoint x="188" y="100"/>
        <di:waypoint x="240" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_fondasi_variant_a_2" bpmnElement="SF_fondasi_variant_a_2">
        <di:waypoint x="360" y="100"/>
        <di:waypoint x="412" y="100"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
