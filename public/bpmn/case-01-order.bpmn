<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Def_Case01"
  targetNamespace="https://uisi.ac.id/bpmn-tutorial">

  <!-- Case 01: Pesanan diterima sampai dikirim -->
  <!-- Modul 1: notasi E01 (None Start/End), A01 (Task), F01 (Sequence Flow) -->
  <!-- id stabil antarversi — jangan diubah tanpa dokumentasi delta -->
  <bpmn:process id="Proc_Case01" name="Proses Pesanan Kasus 1" isExecutable="false">

    <bpmn:startEvent id="SE_PesananDiterima" name="Pesanan diterima">
      <bpmn:outgoing>SF_1_2</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="TA_VerifikasiData" name="Verifikasi data pesanan">
      <bpmn:incoming>SF_1_2</bpmn:incoming>
      <bpmn:outgoing>SF_2_3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="TA_SiapkanPaket" name="Siapkan paket">
      <bpmn:incoming>SF_2_3</bpmn:incoming>
      <bpmn:outgoing>SF_3_4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="TA_KirimPaket" name="Kirim paket">
      <bpmn:incoming>SF_3_4</bpmn:incoming>
      <bpmn:outgoing>SF_4_5</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EE_PesananTerkirim" name="Pesanan terkirim">
      <bpmn:incoming>SF_4_5</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SF_1_2" sourceRef="SE_PesananDiterima" targetRef="TA_VerifikasiData" />
    <bpmn:sequenceFlow id="SF_2_3" sourceRef="TA_VerifikasiData" targetRef="TA_SiapkanPaket" />
    <bpmn:sequenceFlow id="SF_3_4" sourceRef="TA_SiapkanPaket" targetRef="TA_KirimPaket" />
    <bpmn:sequenceFlow id="SF_4_5" sourceRef="TA_KirimPaket" targetRef="EE_PesananTerkirim" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="Dia_Case01">
    <bpmndi:BPMNPlane id="Pla_Case01" bpmnElement="Proc_Case01">
      <bpmndi:BPMNShape id="Shp_SE_1" bpmnElement="SE_PesananDiterima">
        <dc:Bounds x="120" y="160" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="100" y="203" width="76" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shp_TA_2" bpmnElement="TA_VerifikasiData">
        <dc:Bounds x="210" y="138" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shp_TA_3" bpmnElement="TA_SiapkanPaket">
        <dc:Bounds x="400" y="138" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shp_TA_4" bpmnElement="TA_KirimPaket">
        <dc:Bounds x="590" y="138" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shp_EE_5" bpmnElement="EE_PesananTerkirim">
        <dc:Bounds x="780" y="160" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="760" y="203" width="76" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edg_SF_1_2" bpmnElement="SF_1_2">
        <di:waypoint x="156" y="178" /><di:waypoint x="210" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edg_SF_2_3" bpmnElement="SF_2_3">
        <di:waypoint x="350" y="178" /><di:waypoint x="400" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edg_SF_3_4" bpmnElement="SF_3_4">
        <di:waypoint x="540" y="178" /><di:waypoint x="590" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edg_SF_4_5" bpmnElement="SF_4_5">
        <di:waypoint x="730" y="178" /><di:waypoint x="780" y="178" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
