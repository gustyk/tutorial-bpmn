<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Def_Case10"
  targetNamespace="https://uisi.ac.id/bpmn-tutorial">

  <!-- Case 10: Capstone — seluruh Tier A dalam satu kolaborasi e-commerce -->
  <!-- Tier A types: P01 P02 C01 F01 F02 F03 F04 A01 A02 A03 A04 A05 A07 A08 A09 -->
  <!--               A11 A12 A13 A14 A16 G01 G02 G03 G04 D01 D04 R01               -->
  <!--               E01 E02 E03 E05 E06 E07 E08 E11                                -->

  <bpmn:signal id="Sig10_StatusDiminta" name="StatusPesananDiminta" />

  <!-- ============================================================
       KOLABORASI: C01
       ============================================================ -->
  <bpmn:collaboration id="Collab_Cap10" name="Pemenuhan Pesanan E-Commerce — Kapstone">
    <!-- P01: Pool/Participant -->
    <bpmn:participant id="P10_Customer"   name="Customer"          processRef="Proc10_Customer" />
    <bpmn:participant id="P10_Merchant"   name="Merchant"          processRef="Proc10_Merchant" />
    <bpmn:participant id="P10_PayProv"    name="Payment Provider" />
    <bpmn:participant id="P10_JasaKirim"  name="Jasa Pengiriman" />

    <!-- F02: Message Flow -->
    <bpmn:messageFlow id="MF10_1" name="Pesanan"
      sourceRef="TA10_C_BuatPesanan" targetRef="SE10_PesananMasuk" />
    <bpmn:messageFlow id="MF10_2" name="Tagihan pembayaran"
      sourceRef="TA10_KirimTagihan" targetRef="P10_PayProv" />
    <bpmn:messageFlow id="MF10_3" name="Konfirmasi pembayaran"
      sourceRef="P10_PayProv" targetRef="ICE10_BayarDiterima" />
    <bpmn:messageFlow id="MF10_4" name="Instruksi pengiriman"
      sourceRef="CA10_LayananPengiriman" targetRef="P10_JasaKirim" />
    <bpmn:messageFlow id="MF10_5" name="Konfirmasi pengiriman"
      sourceRef="P10_JasaKirim" targetRef="TA10_TerimaKonfirmasi" />
    <bpmn:messageFlow id="MF10_6" name="Pesanan selesai"
      sourceRef="TA10_KirimKonfirmasi" targetRef="IE10_C_KonfirmasiDiterima" />
    <bpmn:messageFlow id="MF10_7" name="Status pesanan"
      sourceRef="EE10_ES_StatusDikirim" targetRef="IE10_C_StatusDiterima" />
  </bpmn:collaboration>

  <!-- ============================================================
       PROSES CUSTOMER
       ============================================================ -->
  <bpmn:process id="Proc10_Customer" name="Proses Customer" isExecutable="false">
    <bpmn:startEvent id="SE10_C_Mulai" name="Kebutuhan muncul">
      <bpmn:outgoing>SF10_C1</bpmn:outgoing>
    </bpmn:startEvent>
    <!-- A08: Send Task -->
    <bpmn:sendTask id="TA10_C_BuatPesanan" name="Buat dan kirim pesanan">
      <bpmn:incoming>SF10_C1</bpmn:incoming>
      <bpmn:outgoing>SF10_C2</bpmn:outgoing>
    </bpmn:sendTask>
    <!-- E02: Message Catch -->
    <bpmn:intermediateCatchEvent id="IE10_C_KonfirmasiDiterima" name="Konfirmasi pesanan diterima">
      <bpmn:incoming>SF10_C2</bpmn:incoming>
      <bpmn:outgoing>SF10_C3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED10_C1" />
    </bpmn:intermediateCatchEvent>
    <!-- E01: None End -->
    <bpmn:endEvent id="EE10_C_Selesai" name="Pesanan selesai">
      <bpmn:incoming>SF10_C3</bpmn:incoming>
    </bpmn:endEvent>
    <!-- Status pesanan: standalone catch (dipicu kapan saja via MF) -->
    <bpmn:intermediateCatchEvent id="IE10_C_StatusDiterima" name="Status diterima">
      <bpmn:outgoing>SF10_C_Status</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED10_C2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EE10_C_StatusDiketahui" name="Status diketahui">
      <bpmn:incoming>SF10_C_Status</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SF10_C1" sourceRef="SE10_C_Mulai" targetRef="TA10_C_BuatPesanan" />
    <bpmn:sequenceFlow id="SF10_C2" sourceRef="TA10_C_BuatPesanan" targetRef="IE10_C_KonfirmasiDiterima" />
    <bpmn:sequenceFlow id="SF10_C3" sourceRef="IE10_C_KonfirmasiDiterima" targetRef="EE10_C_Selesai" />
    <bpmn:sequenceFlow id="SF10_C_Status" sourceRef="IE10_C_StatusDiterima" targetRef="EE10_C_StatusDiketahui" />
  </bpmn:process>

  <!-- ============================================================
       PROSES MERCHANT
       ============================================================ -->
  <bpmn:process id="Proc10_Merchant" name="Proses Merchant" isExecutable="false">

    <!-- P02: Lane -->
    <bpmn:laneSet id="LS10_Merchant">
      <bpmn:lane id="Lane10_CS" name="Tim CS">
        <bpmn:flowNodeRef>SE10_PesananMasuk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TA10_VerifikasiPesanan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW10_DataLengkap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TA10_TolakPesanan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE10_PesananDitolak</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TA10_HitungHarga</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane10_Keuangan" name="Tim Keuangan">
        <bpmn:flowNodeRef>TA10_KirimTagihan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EBG10_TungguBayar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ICE10_BayarDiterima</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ICE10_BatasWaktu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TA10_VerifikasiBayar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TA10_BatalPesanan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ITE10_BatalkanSemua</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE10_PesananBatal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane10_Operasional" name="Tim Operasional">
        <bpmn:flowNodeRef>SubProc10_Fulfillment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TA10_TinjauManual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE10_GagalTotal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TA10_CompHandlerFulfillment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW10_ParalelSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TA10_SiapkanDokumen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA10_LayananPengiriman</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TA10_NotifikasiEskalasi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE10_EskalasiEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW10_ParalelJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TA10_TerimaKonfirmasi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW10_NotifikasiSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TA10_RekamRiwayat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TA10_KirimNotifikasi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW10_NotifikasiJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TA10_KirimKonfirmasi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE10_PesananSelesai</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- D01: Data Object -->
    <bpmn:dataObject id="DO10_Invoice" name="Invoice" />
    <bpmn:dataObjectReference id="DOR10_Invoice" name="Invoice [dibuat]" dataObjectRef="DO10_Invoice" />

    <!-- D04: Data Store Reference -->
    <bpmn:dataStoreReference id="DS10_RiwayatPesanan" name="Riwayat Pesanan" />

    <!-- R01: Text Annotation -->
    <bpmn:textAnnotation id="Anno10_SLA">
      <bpmn:text>SLA verifikasi: maks. 2 jam</bpmn:text>
    </bpmn:textAnnotation>

    <!-- ---- TIM CS ---- -->

    <!-- E02: Message Start Event -->
    <bpmn:startEvent id="SE10_PesananMasuk" name="Pesanan masuk">
      <bpmn:outgoing>SF10_M1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED10_M1" />
    </bpmn:startEvent>

    <!-- A04: User Task -->
    <bpmn:userTask id="TA10_VerifikasiPesanan" name="Verifikasi Pesanan">
      <bpmn:incoming>SF10_M1</bpmn:incoming>
      <bpmn:outgoing>SF10_M2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA10_Invoice">
        <bpmn:targetRef>DOR10_Invoice</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>

    <!-- G01: Exclusive Gateway -->
    <bpmn:exclusiveGateway id="GW10_DataLengkap" name="Data lengkap?">
      <bpmn:incoming>SF10_M2</bpmn:incoming>
      <bpmn:outgoing>SF10_M3_Ya</bpmn:outgoing>
      <bpmn:outgoing>SF10_M3_Tidak</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- A03: Manual Task -->
    <bpmn:manualTask id="TA10_TolakPesanan" name="Tolak pesanan secara manual">
      <bpmn:incoming>SF10_M3_Tidak</bpmn:incoming>
      <bpmn:outgoing>SF10_M4</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- E02: Message End Event -->
    <bpmn:endEvent id="EE10_PesananDitolak" name="Pesanan ditolak">
      <bpmn:incoming>SF10_M4</bpmn:incoming>
      <bpmn:messageEventDefinition id="MED10_M2" />
    </bpmn:endEvent>

    <!-- A07: Business Rule Task -->
    <bpmn:businessRuleTask id="TA10_HitungHarga" name="Hitung Harga dan Diskon">
      <bpmn:incoming>SF10_M3_Ya</bpmn:incoming>
      <bpmn:outgoing>SF10_M5</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <!-- ---- TIM KEUANGAN ---- -->

    <!-- A08: Send Task -->
    <bpmn:sendTask id="TA10_KirimTagihan" name="Kirim Tagihan ke Payment Provider">
      <bpmn:incoming>SF10_M5</bpmn:incoming>
      <bpmn:outgoing>SF10_M6</bpmn:outgoing>
    </bpmn:sendTask>

    <!-- G04: Event-Based Gateway -->
    <bpmn:eventBasedGateway id="EBG10_TungguBayar" name="Tunggu pembayaran">
      <bpmn:incoming>SF10_M6</bpmn:incoming>
      <bpmn:outgoing>SF10_M7_Bayar</bpmn:outgoing>
      <bpmn:outgoing>SF10_M7_Timer</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <!-- E02: Intermediate Message Catch -->
    <bpmn:intermediateCatchEvent id="ICE10_BayarDiterima" name="Pembayaran dikonfirmasi">
      <bpmn:incoming>SF10_M7_Bayar</bpmn:incoming>
      <bpmn:outgoing>SF10_M8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED10_M3" />
    </bpmn:intermediateCatchEvent>

    <!-- E03: Intermediate Timer Catch -->
    <bpmn:intermediateCatchEvent id="ICE10_BatasWaktu" name="Batas waktu habis">
      <bpmn:incoming>SF10_M7_Timer</bpmn:incoming>
      <bpmn:outgoing>SF10_M9</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED10_M1">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>

    <!-- A05: Service Task -->
    <bpmn:serviceTask id="TA10_VerifikasiBayar" name="Verifikasi Pembayaran Otomatis">
      <bpmn:incoming>SF10_M8</bpmn:incoming>
      <bpmn:outgoing>SF10_M10</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- A01: Task (generic) -->
    <bpmn:task id="TA10_BatalPesanan" name="Batalkan Pesanan">
      <bpmn:incoming>SF10_M9</bpmn:incoming>
      <bpmn:outgoing>SF10_M11</bpmn:outgoing>
    </bpmn:task>

    <!-- E08: Intermediate Throw Compensation -->
    <bpmn:intermediateThrowEvent id="ITE10_BatalkanSemua" name="Batalkan aktivitas yang sudah dilakukan">
      <bpmn:incoming>SF10_M11</bpmn:incoming>
      <bpmn:outgoing>SF10_M12</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="CED10_Throw" />
    </bpmn:intermediateThrowEvent>

    <!-- E01: None End -->
    <bpmn:endEvent id="EE10_PesananBatal" name="Pesanan dibatalkan">
      <bpmn:incoming>SF10_M12</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ---- TIM OPERASIONAL ---- -->

    <!-- A13: Embedded Subprocess + A11: Multi-instance (collapsed) -->
    <bpmn:subProcess id="SubProc10_Fulfillment" name="Proses per Item Pesanan">
      <bpmn:incoming>SF10_M10</bpmn:incoming>
      <bpmn:outgoing>SF10_M13</bpmn:outgoing>
      <!-- A11: Multi-instance marker (parallel, satu per item) -->
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" />

      <!-- Inner elements (collapsed — tidak tampil di diagram utama) -->
      <bpmn:startEvent id="SE10_SP_Mulai" name="">
        <bpmn:outgoing>SF10_SP1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="TA10_SP_CekStok" name="Cek stok item">
        <bpmn:incoming>SF10_SP1</bpmn:incoming>
        <bpmn:outgoing>SF10_SP2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="TA10_SP_SiapkanItem" name="Siapkan item pesanan">
        <bpmn:incoming>SF10_SP2</bpmn:incoming>
        <bpmn:outgoing>SF10_SP3</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="EE10_SP_Selesai" name="">
        <bpmn:incoming>SF10_SP3</bpmn:incoming>
      </bpmn:endEvent>

      <bpmn:sequenceFlow id="SF10_SP1" sourceRef="SE10_SP_Mulai" targetRef="TA10_SP_CekStok" />
      <bpmn:sequenceFlow id="SF10_SP2" sourceRef="TA10_SP_CekStok" targetRef="TA10_SP_SiapkanItem" />
      <bpmn:sequenceFlow id="SF10_SP3" sourceRef="TA10_SP_SiapkanItem" targetRef="EE10_SP_Selesai" />
    </bpmn:subProcess>

    <!-- E06: Error Boundary Event (interrupting) on SubProc -->
    <bpmn:boundaryEvent id="BE10_ErrorFulfillment" name="Stok tidak tersedia"
      attachedToRef="SubProc10_Fulfillment" cancelActivity="true">
      <bpmn:outgoing>SF10_M14_Err</bpmn:outgoing>
      <bpmn:errorEventDefinition id="EED10_1" />
    </bpmn:boundaryEvent>

    <!-- E08: Compensation Boundary Event on SubProc -->
    <bpmn:boundaryEvent id="BE10_KompenFulfillment" name="Kompensasi fulfillment"
      attachedToRef="SubProc10_Fulfillment" cancelActivity="true">
      <bpmn:compensateEventDefinition id="CED10_Bdry" />
    </bpmn:boundaryEvent>

    <!-- A12: Compensation Handler (isForCompensation=true) -->
    <bpmn:task id="TA10_CompHandlerFulfillment"
      name="Batalkan dan kembalikan semua item ke stok"
      isForCompensation="true">
    </bpmn:task>

    <!-- A03: Manual Task (error path) -->
    <bpmn:manualTask id="TA10_TinjauManual" name="Tinjau Kegagalan Manual">
      <bpmn:incoming>SF10_M14_Err</bpmn:incoming>
      <bpmn:outgoing>SF10_M14_End</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- E11: Terminate End -->
    <bpmn:endEvent id="EE10_GagalTotal" name="Proses dihentikan">
      <bpmn:incoming>SF10_M14_End</bpmn:incoming>
      <bpmn:terminateEventDefinition id="TED10_Terminate" />
    </bpmn:endEvent>

    <!-- G02: Parallel Gateway (split) -->
    <bpmn:parallelGateway id="GW10_ParalelSplit" name="Mulai paralel">
      <bpmn:incoming>SF10_M13</bpmn:incoming>
      <bpmn:outgoing>SF10_M15_Dok</bpmn:outgoing>
      <bpmn:outgoing>SF10_M15_Kirim</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- A02: None/Undefined Task -->
    <bpmn:task id="TA10_SiapkanDokumen" name="Siapkan Dokumen Pengiriman">
      <bpmn:incoming>SF10_M15_Dok</bpmn:incoming>
      <bpmn:outgoing>SF10_M16_Dok</bpmn:outgoing>
    </bpmn:task>

    <!-- A16: Call Activity -->
    <bpmn:callActivity id="CA10_LayananPengiriman" name="Layanan Pengiriman Pihak Ketiga"
      calledElement="Proc_LayananPengiriman">
      <bpmn:incoming>SF10_M15_Kirim</bpmn:incoming>
      <bpmn:outgoing>SF10_M16_Kirim</bpmn:outgoing>
    </bpmn:callActivity>

    <!-- E07: Escalation Boundary Event (non-interrupting) on Call Activity -->
    <bpmn:boundaryEvent id="BE10_EskalasiPengiriman" name="Masalah pengiriman"
      attachedToRef="CA10_LayananPengiriman" cancelActivity="false">
      <bpmn:outgoing>SF10_M17_Esk</bpmn:outgoing>
      <bpmn:escalationEventDefinition id="ESCED10_1" />
    </bpmn:boundaryEvent>

    <!-- A05: Service Task (escalation notification) -->
    <bpmn:serviceTask id="TA10_NotifikasiEskalasi" name="Notifikasi Supervisor Pengiriman">
      <bpmn:incoming>SF10_M17_Esk</bpmn:incoming>
      <bpmn:outgoing>SF10_M18_Esk</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- E01: None End (escalation path) -->
    <bpmn:endEvent id="EE10_EskalasiEnd" name="Eskalasi selesai">
      <bpmn:incoming>SF10_M18_Esk</bpmn:incoming>
    </bpmn:endEvent>

    <!-- G02: Parallel Gateway (join) -->
    <bpmn:parallelGateway id="GW10_ParalelJoin" name="Tunggu selesai">
      <bpmn:incoming>SF10_M16_Dok</bpmn:incoming>
      <bpmn:incoming>SF10_M16_Kirim</bpmn:incoming>
      <bpmn:outgoing>SF10_M19</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- A09: Receive Task -->
    <bpmn:receiveTask id="TA10_TerimaKonfirmasi" name="Terima Konfirmasi Pengiriman">
      <bpmn:incoming>SF10_M19</bpmn:incoming>
      <bpmn:outgoing>SF10_M20</bpmn:outgoing>
    </bpmn:receiveTask>

    <!-- G03: Inclusive Gateway (split) -->
    <bpmn:inclusiveGateway id="GW10_NotifikasiSplit" name="Proses notifikasi">
      <bpmn:incoming>SF10_M20</bpmn:incoming>
      <bpmn:outgoing>SF10_M21_Rekam</bpmn:outgoing>
      <bpmn:outgoing>SF10_M21_Notif</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- A05: Service Task (rekam riwayat) -->
    <bpmn:serviceTask id="TA10_RekamRiwayat" name="Rekam ke Riwayat Pesanan">
      <bpmn:incoming>SF10_M21_Rekam</bpmn:incoming>
      <bpmn:outgoing>SF10_M22_Rekam</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA10_Riwayat">
        <bpmn:targetRef>DS10_RiwayatPesanan</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>

    <!-- A01: Task (kirim notifikasi customer) -->
    <bpmn:task id="TA10_KirimNotifikasi" name="Kirim Notifikasi Customer">
      <bpmn:incoming>SF10_M21_Notif</bpmn:incoming>
      <bpmn:outgoing>SF10_M22_Notif</bpmn:outgoing>
    </bpmn:task>

    <!-- G03: Inclusive Gateway (join) -->
    <bpmn:inclusiveGateway id="GW10_NotifikasiJoin" name="Notifikasi selesai">
      <bpmn:incoming>SF10_M22_Rekam</bpmn:incoming>
      <bpmn:incoming>SF10_M22_Notif</bpmn:incoming>
      <bpmn:outgoing>SF10_M23</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- A08: Send Task (kirim konfirmasi final ke customer) -->
    <bpmn:sendTask id="TA10_KirimKonfirmasi" name="Kirim Konfirmasi Pesanan ke Customer">
      <bpmn:incoming>SF10_M23</bpmn:incoming>
      <bpmn:outgoing>SF10_M24</bpmn:outgoing>
    </bpmn:sendTask>

    <!-- E01: None End -->
    <bpmn:endEvent id="EE10_PesananSelesai" name="Pesanan dikirim">
      <bpmn:incoming>SF10_M24</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ---- EVENT SUBPROCESS: A14 (non-interrupting) + E05 (Signal) ---- -->
    <bpmn:subProcess id="EVSP10_StatusQuery" triggeredByEvent="true"
      name="Layanan Status Pesanan">
      <!-- E05: Signal Start Event -->
      <bpmn:startEvent id="SE10_ES_StatusDiminta" name="Customer meminta status" isInterrupting="false">
        <bpmn:outgoing>SF10_ES1</bpmn:outgoing>
        <bpmn:signalEventDefinition id="SED10_ES1" signalRef="Sig10_StatusDiminta" />
      </bpmn:startEvent>
      <!-- A05: Service Task -->
      <bpmn:serviceTask id="TA10_ES_CekStatus" name="Cek dan kirim status pesanan">
        <bpmn:incoming>SF10_ES1</bpmn:incoming>
        <bpmn:outgoing>SF10_ES2</bpmn:outgoing>
      </bpmn:serviceTask>
      <!-- E02: Message End (kirim ke customer) -->
      <bpmn:endEvent id="EE10_ES_StatusDikirim" name="Status pesanan dikirim">
        <bpmn:incoming>SF10_ES2</bpmn:incoming>
        <bpmn:messageEventDefinition id="MED10_ES1" />
      </bpmn:endEvent>

      <bpmn:sequenceFlow id="SF10_ES1" sourceRef="SE10_ES_StatusDiminta" targetRef="TA10_ES_CekStatus" />
      <bpmn:sequenceFlow id="SF10_ES2" sourceRef="TA10_ES_CekStatus" targetRef="EE10_ES_StatusDikirim" />
    </bpmn:subProcess>

    <!-- ---- ASSOCIATIONS ---- -->
    <!-- F03: Association (TextAnnotation SLA → TA_VerifikasiPesanan) -->
    <bpmn:association id="Assoc10_SLA"
      sourceRef="TA10_VerifikasiPesanan" targetRef="Anno10_SLA" />
    <!-- Compensation handler link -->
    <bpmn:association id="Assoc10_Comp"
      sourceRef="BE10_KompenFulfillment" targetRef="TA10_CompHandlerFulfillment" />

    <!-- ---- SEQUENCE FLOWS (main process) ---- -->
    <bpmn:sequenceFlow id="SF10_M1"  sourceRef="SE10_PesananMasuk"    targetRef="TA10_VerifikasiPesanan" />
    <bpmn:sequenceFlow id="SF10_M2"  sourceRef="TA10_VerifikasiPesanan" targetRef="GW10_DataLengkap" />
    <bpmn:sequenceFlow id="SF10_M3_Tidak" name="tidak lengkap"
      sourceRef="GW10_DataLengkap" targetRef="TA10_TolakPesanan">
      <bpmn:conditionExpression>data tidak lengkap</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SF10_M3_Ya" name="lengkap"
      sourceRef="GW10_DataLengkap" targetRef="TA10_HitungHarga">
      <bpmn:conditionExpression>data lengkap</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SF10_M4"  sourceRef="TA10_TolakPesanan"    targetRef="EE10_PesananDitolak" />
    <bpmn:sequenceFlow id="SF10_M5"  sourceRef="TA10_HitungHarga"     targetRef="TA10_KirimTagihan" />
    <bpmn:sequenceFlow id="SF10_M6"  sourceRef="TA10_KirimTagihan"    targetRef="EBG10_TungguBayar" />
    <bpmn:sequenceFlow id="SF10_M7_Bayar" sourceRef="EBG10_TungguBayar" targetRef="ICE10_BayarDiterima" />
    <bpmn:sequenceFlow id="SF10_M7_Timer" sourceRef="EBG10_TungguBayar" targetRef="ICE10_BatasWaktu" />
    <bpmn:sequenceFlow id="SF10_M8"  sourceRef="ICE10_BayarDiterima"  targetRef="TA10_VerifikasiBayar" />
    <bpmn:sequenceFlow id="SF10_M9"  sourceRef="ICE10_BatasWaktu"     targetRef="TA10_BatalPesanan" />
    <bpmn:sequenceFlow id="SF10_M10" sourceRef="TA10_VerifikasiBayar" targetRef="SubProc10_Fulfillment" />
    <bpmn:sequenceFlow id="SF10_M11" sourceRef="TA10_BatalPesanan"    targetRef="ITE10_BatalkanSemua" />
    <bpmn:sequenceFlow id="SF10_M12" sourceRef="ITE10_BatalkanSemua"  targetRef="EE10_PesananBatal" />
    <bpmn:sequenceFlow id="SF10_M13" sourceRef="SubProc10_Fulfillment" targetRef="GW10_ParalelSplit" />
    <bpmn:sequenceFlow id="SF10_M14_Err" sourceRef="BE10_ErrorFulfillment" targetRef="TA10_TinjauManual" />
    <bpmn:sequenceFlow id="SF10_M14_End" sourceRef="TA10_TinjauManual"    targetRef="EE10_GagalTotal" />
    <bpmn:sequenceFlow id="SF10_M15_Dok"  sourceRef="GW10_ParalelSplit"   targetRef="TA10_SiapkanDokumen" />
    <bpmn:sequenceFlow id="SF10_M15_Kirim" sourceRef="GW10_ParalelSplit"  targetRef="CA10_LayananPengiriman" />
    <bpmn:sequenceFlow id="SF10_M16_Dok"  sourceRef="TA10_SiapkanDokumen" targetRef="GW10_ParalelJoin" />
    <bpmn:sequenceFlow id="SF10_M16_Kirim" sourceRef="CA10_LayananPengiriman" targetRef="GW10_ParalelJoin" />
    <bpmn:sequenceFlow id="SF10_M17_Esk" sourceRef="BE10_EskalasiPengiriman" targetRef="TA10_NotifikasiEskalasi" />
    <bpmn:sequenceFlow id="SF10_M18_Esk" sourceRef="TA10_NotifikasiEskalasi" targetRef="EE10_EskalasiEnd" />
    <bpmn:sequenceFlow id="SF10_M19"  sourceRef="GW10_ParalelJoin"     targetRef="TA10_TerimaKonfirmasi" />
    <bpmn:sequenceFlow id="SF10_M20"  sourceRef="TA10_TerimaKonfirmasi" targetRef="GW10_NotifikasiSplit" />
    <bpmn:sequenceFlow id="SF10_M21_Rekam" sourceRef="GW10_NotifikasiSplit" targetRef="TA10_RekamRiwayat" />
    <bpmn:sequenceFlow id="SF10_M21_Notif" sourceRef="GW10_NotifikasiSplit" targetRef="TA10_KirimNotifikasi" />
    <bpmn:sequenceFlow id="SF10_M22_Rekam" sourceRef="TA10_RekamRiwayat"   targetRef="GW10_NotifikasiJoin" />
    <bpmn:sequenceFlow id="SF10_M22_Notif" sourceRef="TA10_KirimNotifikasi" targetRef="GW10_NotifikasiJoin" />
    <bpmn:sequenceFlow id="SF10_M23"  sourceRef="GW10_NotifikasiJoin"  targetRef="TA10_KirimKonfirmasi" />
    <bpmn:sequenceFlow id="SF10_M24"  sourceRef="TA10_KirimKonfirmasi" targetRef="EE10_PesananSelesai" />
  </bpmn:process>

