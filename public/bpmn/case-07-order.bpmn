<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Def_Case07"
  targetNamespace="https://uisi.ac.id/bpmn-tutorial">

  <!-- Case 07: Model mulai terlalu padat -->
  <!-- Modul 7: superset Case 06 + A13 (Embedded Subprocess), A16 (Call Activity), A11 (Multi-instance) -->
  <!-- Reuse negatif: Subprocess hanya merapikan gambar; multi-instance padahal urutan tunggal -->

  <bpmn:collaboration id="Collab_Case07" name="Pesanan Kasus 7">

    <bpmn:participant id="Part07_Customer" name="Customer" processRef="Proc07_Customer" />
    <bpmn:participant id="Part07_Merchant" name="Merchant" processRef="Proc07_Merchant" />

    <bpmn:messageFlow id="MF07_PesananDikirim" name="Pesanan dikirim"
      sourceRef="TA07_BuatPesanan" targetRef="SE07_PesananDiterima" />
    <bpmn:messageFlow id="MF07_InstruksiBayar" name="Instruksi pembayaran"
      sourceRef="TA07_KirimInstruksiBayar" targetRef="IE07_InstruksiBayarDiterima" />
    <bpmn:messageFlow id="MF07_KonfirmasiBayar" name="Konfirmasi pembayaran"
      sourceRef="TA07_KirimBuktiBayar" targetRef="IE07_KonfirmasiBayarDiterima" />
    <bpmn:messageFlow id="MF07_KonfirmasiPesanan" name="Konfirmasi pesanan"
      sourceRef="TA07_KirimKonfirmasi" targetRef="IE07_KonfirmasiDiterima" />

  </bpmn:collaboration>

  <!-- Proses Customer -->
  <bpmn:process id="Proc07_Customer" name="Proses Customer" isExecutable="false">
    <bpmn:startEvent id="SE07_CustomerMulai" name="Kebutuhan barang muncul">
      <bpmn:outgoing>SF07_C1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="TA07_BuatPesanan" name="Buat dan kirim pesanan">
      <bpmn:incoming>SF07_C1</bpmn:incoming>
      <bpmn:outgoing>SF07_C2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="IE07_InstruksiBayarDiterima" name="Instruksi pembayaran diterima">
      <bpmn:incoming>SF07_C2</bpmn:incoming>
      <bpmn:outgoing>SF07_C3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED07_C1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="TA07_LakukanPembayaran" name="Lakukan pembayaran">
      <bpmn:incoming>SF07_C3</bpmn:incoming>
      <bpmn:outgoing>SF07_C4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="TA07_KirimBuktiBayar" name="Kirim bukti pembayaran">
      <bpmn:incoming>SF07_C4</bpmn:incoming>
      <bpmn:outgoing>SF07_C5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="IE07_KonfirmasiDiterima" name="Konfirmasi pesanan diterima">
      <bpmn:incoming>SF07_C5</bpmn:incoming>
      <bpmn:outgoing>SF07_C6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED07_C2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EE07_CustomerSelesai" name="Pesanan dikonfirmasi">
      <bpmn:incoming>SF07_C6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF07_C1" sourceRef="SE07_CustomerMulai" targetRef="TA07_BuatPesanan" />
    <bpmn:sequenceFlow id="SF07_C2" sourceRef="TA07_BuatPesanan" targetRef="IE07_InstruksiBayarDiterima" />
    <bpmn:sequenceFlow id="SF07_C3" sourceRef="IE07_InstruksiBayarDiterima" targetRef="TA07_LakukanPembayaran" />
    <bpmn:sequenceFlow id="SF07_C4" sourceRef="TA07_LakukanPembayaran" targetRef="TA07_KirimBuktiBayar" />
    <bpmn:sequenceFlow id="SF07_C5" sourceRef="TA07_KirimBuktiBayar" targetRef="IE07_KonfirmasiDiterima" />
    <bpmn:sequenceFlow id="SF07_C6" sourceRef="IE07_KonfirmasiDiterima" targetRef="EE07_CustomerSelesai" />
  </bpmn:process>

  <!-- Proses Merchant: padat → Subprocess untuk pemenuhan -->
  <bpmn:process id="Proc07_Merchant" name="Proses Merchant" isExecutable="false">

    <bpmn:laneSet id="LS07_Merchant">
      <bpmn:lane id="Lane07_CS" name="Tim CS">
        <bpmn:flowNodeRef>SE07_PesananDiterima</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TA07_CatatPesanan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TA07_VerifikasiData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW07_DataValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE07_PesananDitolak</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TA07_KirimInstruksiBayar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW07_TungguBayar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IE07_KonfirmasiBayarDiterima</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IE07_TimerHabis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE07_BatasWaktuHabis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA07_VerifAlamat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TA07_KirimKonfirmasi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE07_MerchantSelesai</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane07_Gudang" name="Tim Gudang">
        <bpmn:flowNodeRef>SP07_Pemenuhan</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Text Annotation -->
    <bpmn:textAnnotation id="NOTE07_Subprocess">
      <bpmn:text>Subprocess menyembunyikan detail pemenuhan yang sebelumnya memadati Lane Tim Gudang</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="ASSOC07_1" sourceRef="SP07_Pemenuhan" targetRef="NOTE07_Subprocess" />

    <!-- Tim CS -->
    <bpmn:startEvent id="SE07_PesananDiterima" name="Pesanan diterima dari customer">
      <bpmn:outgoing>SF07_M1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED07_M1" />
    </bpmn:startEvent>
    <bpmn:userTask id="TA07_CatatPesanan" name="Catat data pesanan">
      <bpmn:incoming>SF07_M1</bpmn:incoming>
      <bpmn:outgoing>SF07_M2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="TA07_VerifikasiData" name="Verifikasi data pesanan">
      <bpmn:incoming>SF07_M2</bpmn:incoming>
      <bpmn:outgoing>SF07_M3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW07_DataValid" name="Data valid?">
      <bpmn:incoming>SF07_M3</bpmn:incoming>
      <bpmn:outgoing>SF07_M_Ya</bpmn:outgoing>
      <bpmn:outgoing>SF07_M_Tidak</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EE07_PesananDitolak" name="Pesanan ditolak">
      <bpmn:incoming>SF07_M_Tidak</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="TA07_KirimInstruksiBayar" name="Kirim instruksi pembayaran ke customer">
      <bpmn:incoming>SF07_M_Ya</bpmn:incoming>
      <bpmn:outgoing>SF07_M4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="GW07_TungguBayar" name="Tunggu hasil pembayaran">
      <bpmn:incoming>SF07_M4</bpmn:incoming>
      <bpmn:outgoing>SF07_M_Bayar</bpmn:outgoing>
      <bpmn:outgoing>SF07_M_Timer</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="IE07_KonfirmasiBayarDiterima" name="Bukti pembayaran diterima">
      <bpmn:incoming>SF07_M_Bayar</bpmn:incoming>
      <bpmn:outgoing>SF07_M5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED07_M2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="IE07_TimerHabis" name="24 jam berlalu tanpa pembayaran">
      <bpmn:incoming>SF07_M_Timer</bpmn:incoming>
      <bpmn:outgoing>SF07_M_Cancel</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED07_M1">
        <bpmn:timeDuration>PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EE07_BatasWaktuHabis" name="Pesanan dibatalkan — batas waktu habis">
      <bpmn:incoming>SF07_M_Cancel</bpmn:incoming>
    </bpmn:endEvent>

    <!-- A16: Call Activity — proses verifikasi alamat yang dapat dipakai ulang -->
    <bpmn:callActivity id="CA07_VerifAlamat" name="Verifikasi Alamat Pengiriman" calledElement="Proc_VerifAlamat">
      <bpmn:incoming>SF07_M5</bpmn:incoming>
      <bpmn:outgoing>SF07_M6</bpmn:outgoing>
    </bpmn:callActivity>

    <!-- A13: Embedded Subprocess (collapsed) — pemenuhan pesanan dengan multi-instance -->
    <bpmn:subProcess id="SP07_Pemenuhan" name="Pemenuhan Pesanan">
      <bpmn:incoming>SF07_M6</bpmn:incoming>
      <bpmn:outgoing>SF07_M7</bpmn:outgoing>

      <!-- Isi subprocess (ditampilkan collapsed di diagram utama) -->
      <bpmn:startEvent id="SE07_SP_Mulai" name="">
        <bpmn:outgoing>SF07_SP1</bpmn:outgoing>
      </bpmn:startEvent>

      <!-- A11: Multi-instance Task (sequential) — setiap item diproses satu per satu -->
      <bpmn:task id="TA07_ProsesItem" name="Proses satu item pesanan">
        <bpmn:incoming>SF07_SP1</bpmn:incoming>
        <bpmn:outgoing>SF07_SP2</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      </bpmn:task>

      <bpmn:task id="TA07_TerbitkanInvoice" name="Terbitkan invoice">
        <bpmn:incoming>SF07_SP2</bpmn:incoming>
        <bpmn:outgoing>SF07_SP3</bpmn:outgoing>
      </bpmn:task>

      <bpmn:endEvent id="EE07_SP_Selesai" name="">
        <bpmn:incoming>SF07_SP3</bpmn:incoming>
      </bpmn:endEvent>

      <bpmn:sequenceFlow id="SF07_SP1" sourceRef="SE07_SP_Mulai" targetRef="TA07_ProsesItem" />
      <bpmn:sequenceFlow id="SF07_SP2" sourceRef="TA07_ProsesItem" targetRef="TA07_TerbitkanInvoice" />
      <bpmn:sequenceFlow id="SF07_SP3" sourceRef="TA07_TerbitkanInvoice" targetRef="EE07_SP_Selesai" />
    </bpmn:subProcess>

    <bpmn:serviceTask id="TA07_KirimKonfirmasi" name="Kirim konfirmasi pesanan ke customer">
      <bpmn:incoming>SF07_M7</bpmn:incoming>
      <bpmn:outgoing>SF07_M8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EE07_MerchantSelesai" name="Pesanan dikirim">
      <bpmn:incoming>SF07_M8</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SF07_M1" sourceRef="SE07_PesananDiterima" targetRef="TA07_CatatPesanan" />
    <bpmn:sequenceFlow id="SF07_M2" sourceRef="TA07_CatatPesanan" targetRef="TA07_VerifikasiData" />
    <bpmn:sequenceFlow id="SF07_M3" sourceRef="TA07_VerifikasiData" targetRef="GW07_DataValid" />
    <bpmn:sequenceFlow id="SF07_M_Ya" name="ya" sourceRef="GW07_DataValid" targetRef="TA07_KirimInstruksiBayar">
      <bpmn:conditionExpression>data lengkap</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SF07_M_Tidak" name="tidak" sourceRef="GW07_DataValid" targetRef="EE07_PesananDitolak">
      <bpmn:conditionExpression>data tidak lengkap</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SF07_M4" sourceRef="TA07_KirimInstruksiBayar" targetRef="GW07_TungguBayar" />
    <bpmn:sequenceFlow id="SF07_M_Bayar" sourceRef="GW07_TungguBayar" targetRef="IE07_KonfirmasiBayarDiterima" />
    <bpmn:sequenceFlow id="SF07_M_Timer" sourceRef="GW07_TungguBayar" targetRef="IE07_TimerHabis" />
    <bpmn:sequenceFlow id="SF07_M5" sourceRef="IE07_KonfirmasiBayarDiterima" targetRef="CA07_VerifAlamat" />
    <bpmn:sequenceFlow id="SF07_M_Cancel" sourceRef="IE07_TimerHabis" targetRef="EE07_BatasWaktuHabis" />
    <bpmn:sequenceFlow id="SF07_M6" sourceRef="CA07_VerifAlamat" targetRef="SP07_Pemenuhan" />
    <bpmn:sequenceFlow id="SF07_M7" sourceRef="SP07_Pemenuhan" targetRef="TA07_KirimKonfirmasi" />
    <bpmn:sequenceFlow id="SF07_M8" sourceRef="TA07_KirimKonfirmasi" targetRef="EE07_MerchantSelesai" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="Dia_Case07">
    <bpmndi:BPMNPlane id="Pla_Case07" bpmnElement="Collab_Case07">

      <!-- Pool Customer -->
      <bpmndi:BPMNShape id="Shp07_PartC" bpmnElement="Part07_Customer" isHorizontal="true">
        <dc:Bounds x="60" y="60" width="1100" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shp07_SE_CM" bpmnElement="SE07_CustomerMulai">
        <dc:Bounds x="130" y="123" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="108" y="166" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shp07_TA_BP" bpmnElement="TA07_BuatPesanan">
        <dc:Bounds x="220" y="101" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shp07_IE_IBD" bpmnElement="IE07_InstruksiBayarDiterima">
        <dc:Bounds x="400" y="123" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="378" y="166" width="80" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shp07_TA_LP" bpmnElement="TA07_LakukanPembayaran">
        <dc:Bounds x="490" y="101" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shp07_TA_KBB" bpmnElement="TA07_KirimBuktiBayar">
        <dc:Bounds x="670" y="101" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shp07_IE_KD" bpmnElement="IE07_KonfirmasiDiterima">
        <dc:Bounds x="850" y="123" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="828" y="166" width="80" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shp07_EE_CS" bpmnElement="EE07_CustomerSelesai">
        <dc:Bounds x="950" y="123" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="930" y="166" width="76" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="EdgC07_1" bpmnElement="SF07_C1"><di:waypoint x="166" y="141" /><di:waypoint x="220" y="141" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="EdgC07_2" bpmnElement="SF07_C2"><di:waypoint x="340" y="141" /><di:waypoint x="400" y="141" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="EdgC07_3" bpmnElement="SF07_C3"><di:waypoint x="436" y="141" /><di:waypoint x="490" y="141" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="EdgC07_4" bpmnElement="SF07_C4"><di:waypoint x="610" y="141" /><di:waypoint x="670" y="141" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="EdgC07_5" bpmnElement="SF07_C5"><di:waypoint x="790" y="141" /><di:waypoint x="850" y="141" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="EdgC07_6" bpmnElement="SF07_C6"><di:waypoint x="886" y="141" /><di:waypoint x="950" y="141" /></bpmndi:BPMNEdge>

      <!-- Pool Merchant -->
      <bpmndi:BPMNShape id="Shp07_PartM" bpmnElement="Part07_Merchant" isHorizontal="true">
        <dc:Bounds x="60" y="270" width="1100" height="500" />
      </bpmndi:BPMNShape>

      <!-- Lane Tim CS -->
      <bpmndi:BPMNShape id="Shp07_LaneCS" bpmnElement="Lane07_CS" isHorizontal="true">
        <dc:Bounds x="90" y="270" width="1070" height="270" />
      </bpmndi:BPMNShape>

      <!-- Lane Tim Gudang -->
      <bpmndi:BPMNShape id="Shp07_LaneGd" bpmnElement="Lane07_Gudang" isHorizontal="true">
        <dc:Bounds x="90" y="540" width="1070" height="230" />
      </bpmndi:BPMNShape>

      <!-- Tim CS elements -->
      <bpmndi:BPMNShape id="Shp07_SE_PD" bpmnElement="SE07_PesananDiterima">
        <dc:Bounds x="130" y="381" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="105" y="424" width="86" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shp07_TA_CP" bpmnElement="TA07_CatatPesanan">
        <dc:Bounds x="220" y="359" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shp07_TA_VD" bpmnElement="TA07_VerifikasiData">
        <dc:Bounds x="380" y="359" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shp07_GW_DV" bpmnElement="GW07_DataValid" isMarkerVisible="true">
        <dc:Bounds x="545" y="374" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="528" y="431" width="84" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shp07_EE_PD" bpmnElement="EE07_PesananDitolak">
        <dc:Bounds x="660" y="381" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="638" y="424" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shp07_TA_KIB" bpmnElement="TA07_KirimInstruksiBayar">
        <dc:Bounds x="640" y="359" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shp07_GW_TB" bpmnElement="GW07_TungguBayar">
        <dc:Bounds x="810" y="374" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="790" y="431" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shp07_IE_KBD" bpmnElement="IE07_KonfirmasiBayarDiterima">
        <dc:Bounds x="920" y="381" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="896" y="424" width="84" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shp07_IE_TH" bpmnElement="IE07_TimerHabis">
        <dc:Bounds x="810" y="480" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="790" y="523" width="76" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shp07_EE_BWH" bpmnElement="EE07_BatasWaktuHabis">
        <dc:Bounds x="920" y="480" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="898" y="523" width="80" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- A16: Call Activity -->
      <bpmndi:BPMNShape id="Shp07_CA_VA" bpmnElement="CA07_VerifAlamat">
        <dc:Bounds x="1010" y="359" width="110" height="80" />
      </bpmndi:BPMNShape>

      <!-- Konfirmasi & End -->
      <bpmndi:BPMNShape id="Shp07_TA_KK" bpmnElement="TA07_KirimKonfirmasi">
        <dc:Bounds x="1010" y="278" width="100" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shp07_EE_MS" bpmnElement="EE07_MerchantSelesai">
        <dc:Bounds x="1130" y="289" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1110" y="332" width="76" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Tim Gudang: A13 Embedded Subprocess (collapsed) with multi-instance marker -->
      <bpmndi:BPMNShape id="Shp07_SP_Pem" bpmnElement="SP07_Pemenuhan" isExpanded="false">
        <dc:Bounds x="900" y="570" width="200" height="80" />
      </bpmndi:BPMNShape>

      <!-- Text Annotation -->
      <bpmndi:BPMNShape id="Shp07_Note1" bpmnElement="NOTE07_Subprocess">
        <dc:Bounds x="680" y="565" width="200" height="50" />
      </bpmndi:BPMNShape>

      <!-- Sequence Flow edges (Tim CS) -->
      <bpmndi:BPMNEdge id="Edg07_M1" bpmnElement="SF07_M1"><di:waypoint x="166" y="399" /><di:waypoint x="220" y="399" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edg07_M2" bpmnElement="SF07_M2"><di:waypoint x="330" y="399" /><di:waypoint x="380" y="399" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edg07_M3" bpmnElement="SF07_M3"><di:waypoint x="490" y="399" /><di:waypoint x="545" y="399" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edg07_M_Ya" bpmnElement="SF07_M_Ya">
        <di:waypoint x="595" y="399" /><di:waypoint x="640" y="399" />
        <bpmndi:BPMNLabel><dc:Bounds x="608" y="381" width="14" height="14" /></bpmndi:BPMNLabel>
