{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "inventory.schema.json",
  "title": "BPMN Notation Inventory",
  "type": "object",
  "required": ["scope", "sources", "eventPositions", "events", "elements", "limitations"],
  "properties": {
    "scope": { "type": "string" },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "url", "kind", "checked", "status"],
        "properties": {
          "id": { "type": "string" },
          "url": { "type": "string" },
          "kind": { "type": "string" },
          "checked": { "type": "string" },
          "status": { "type": "string", "enum": ["VERIFIED", "DRAFTED", "TODO"] },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "eventPositions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "events": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "type": "object",
        "required": ["type", "allowed", "status", "tierByPosition"],
        "properties": {
          "type": { "type": "string" },
          "allowed": { "type": "string" },
          "status": { "type": "string", "enum": ["VERIFIED", "DRAFTED", "TODO"] },
          "tierByPosition": {
            "type": "object",
            "required": ["start", "intermediateCatch", "intermediateThrow", "boundaryInterrupting", "boundaryNonInterrupting", "eventSubprocessInterrupting", "eventSubprocessNonInterrupting", "end"],
            "properties": {
              "start": { "type": ["string", "null"], "enum": ["A", "B", "C", null] },
              "intermediateCatch": { "type": ["string", "null"], "enum": ["A", "B", "C", null] },
              "intermediateThrow": { "type": ["string", "null"], "enum": ["A", "B", "C", null] },
              "boundaryInterrupting": { "type": ["string", "null"], "enum": ["A", "B", "C", null] },
              "boundaryNonInterrupting": { "type": ["string", "null"], "enum": ["A", "B", "C", null] },
              "eventSubprocessInterrupting": { "type": ["string", "null"], "enum": ["A", "B", "C", null] },
              "eventSubprocessNonInterrupting": { "type": ["string", "null"], "enum": ["A", "B", "C", null] },
              "end": { "type": ["string", "null"], "enum": ["A", "B", "C", null] }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "elements": {
      "type": "array",
      "minItems": 48,
      "maxItems": 48,
      "items": {
        "type": "object",
        "required": ["id", "category", "notation", "status", "tier", "slug", "introducedIn", "reusedIn", "sources"],
        "properties": {
          "id": { "type": "string", "pattern": "^[PCFAGRDE][0-9]{2}$" },
          "category": { "type": "string" },
          "notation": { "type": "string" },
          "variants": { "type": "string" },
          "camunda": { "type": "string" },
          "chapter": { "type": "string" },
          "docPath": { "type": "string" },
          "status": { "type": "string", "enum": ["VERIFIED", "DRAFTED", "TODO"] },
          "tier": { "type": "string", "enum": ["A", "B", "C"] },
          "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "introducedIn": { "type": ["string", "null"] },
          "reusedIn": { "type": "array", "items": { "type": "string" } },
          "sources": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
